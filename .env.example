# Optional: pre-fill credentials so the app starts configured.
# If unset, the app will prompt for these on first launch via an in-app modal,
# and store the values in .likho_config.json (gitignored).
#
# At least one provider key is required to run OCR. The active provider
# is selected in the credentials modal (the gear icon).

# OpenAI (model: gpt-4o)
OPENAI_API_KEY=sk-...

# Anthropic Claude (model: claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (model: gemini-2.5-flash)
GEMINI_API_KEY=AIza...

# Mistral (model: mistral-medium-latest)
MISTRAL_API_KEY=...

# Local OpenAI-compatible server (Ollama, LM Studio, vLLM) — pick a vision-capable
# model, e.g. `ollama pull llama3.2-vision`. Most local servers need no API key.
# Running the backend in Docker? Use http://host.docker.internal:11434/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2-vision
# Only if your server enforces auth (e.g. vLLM --api-key):
LOCAL_API_KEY=
